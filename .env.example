# Модель, которая переписывает новости под настроение.
# Скопируй в .env и впиши ключ: cp .env.example .env
#
# Подойдёт любой OpenAI-совместимый эндпоинт — значения ниже указывают на
# z.ai / GLM, для OpenRouter или Groq достаточно поменять эти три переменные.
# Ключ z.ai: https://z.ai
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_API_KEY=

# Без LLM_API_KEY сервер работает на заглушке: новости отдаются
# механически преобразованными и явно помечаются как несгенерированные.
